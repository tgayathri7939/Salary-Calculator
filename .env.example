# SalaryFlow Environment Configuration
# Copy this file to .env and fill in your Firebase project credentials.
# IMPORTANT: This file SHOULD be committed to git.
# The .env file (with real values) MUST NOT be committed to git.

# Firebase Web App Configuration
# Get these from: Firebase Console → Project Settings → General → Your apps → Web app
# SECURITY NOTE: These values are NOT secrets. They identify your Firebase project.
# Real security is enforced by Firestore Security Rules, not by keeping these hidden.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Leave all values as-is (or unset) to run in Demo Mode (localStorage only).
# Demo Mode is for development and evaluation only — NOT for production use.
