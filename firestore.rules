rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All user data is nested under users/{uid}
    // Only the authenticated owner can read/write their own data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Employee records
      match /employees/{employeeId} {
        allow read, list: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.uid == uid
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0;
        allow update: if request.auth != null && request.auth.uid == uid
                      && request.resource.data.uid == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // Salary calculations (immutable inputs + calculated totals)
      match /salaryCalculations/{calcId} {
        allow read, list: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.uid == uid
                      && request.resource.data.employeeName is string
                      && request.resource.data.grossSalary is number
                      && request.resource.data.netSalary is number;
        allow update: if request.auth != null && request.auth.uid == uid
                      && request.resource.data.uid == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // Activity logs (write-only from client, readable for UI display)
      match /activityLogs/{logId} {
        allow read, list: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.uid == uid;
        allow update, delete: if false; // Logs are immutable
      }

      // User settings
      match /settings/{settingsId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
